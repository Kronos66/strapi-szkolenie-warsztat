meta {
  name: Zadanie — artykuły autora
  type: http
  seq: 3
}

get {
  url: {{baseUrl}}/api/articles?filters[author][name][$eq]={{authorName}}&populate=author
  body: none
  auth: none
}

params:query {
  filters[author][name][$eq]: {{authorName}}
  populate: author
}

tests {
  test("Status 200", function () {
    expect(res.status).to.equal(200);
  });
}

docs {
  Filtr po polu relacji. Zmienna `authorName` ma domyślnie „David Doe” (autor z danych przykładowych) — zapytanie zwraca 2 artykuły.
}
